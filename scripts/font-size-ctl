#!/bin/bash

# Universal Font Sizer helper — per-target font size get/set/reset.
#
# The system's `omarchy display text size` drives the same three settings in
# lockstep; this helper makes each knob addressable on its own:
#   shell  ~/.config/omarchy/shell.toml [font] base-size (px, the rem root
#          every shell type size derives from; hot-reloads on save)
#   gtk    org.gnome.desktop.interface text-scaling-factor (set as a whole
#          interface-font point size, so the factor stays quantized and
#          GTK4 menus don't clip at the ascenders on scale-1 monitors)
#   term   terminal font point size (alacritty/kitty/ghostty/foot), with the
#          same live-reload signals omarchy-display-text-size uses
#
# Usage:
#   font-size-ctl get
#   font-size-ctl set [--shell PX] [--gtk PT] [--term PT]
#   font-size-ctl reset [shell|gtk|term|all]
#
# get prints key=value lines:
#   shell-px=N gtk-font-pt=N gtk-pt=N gtk-factor=F term-pt=N
#
# Units: shell is a px base-size; gtk-pt is the effective GTK interface font
# point size (factor = gtk-pt / gtk-font-pt); term-pt is the terminal font
# point size. Defaults mirror omarchy-display-text-size: 12px shell base,
# factor 1.0, 9pt terminal (at a 11pt GTK interface font).

MIN_SHELL_PX=8
MAX_SHELL_PX=32
MIN_GTK_PT=6
MAX_GTK_PT=30
MIN_TERM_PT=6
MAX_TERM_PT=24
TERM_DEFAULT_PT=9
SHELL_DEFAULT_PX=12
GTK_DEFAULT_FACTOR=1
GKEY_SCHEMA="org.gnome.desktop.interface"
GKEY_NAME="text-scaling-factor"

shell_config="$HOME/.config/omarchy/shell.toml"

usage() {
  echo "Usage: font-size-ctl get | set [--shell PX] [--gtk PT] [--term PT] | reset [shell|gtk|term|all]"
}

die() {
  echo "$1" >&2
  usage >&2
  exit 1
}

is_int() { [[ $1 =~ ^[0-9]+$ ]]; }

# ---- shell base-size ----

current_base_size() {
  [[ -f $shell_config ]] || return 0
  awk '
    /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\]([[:space:]]|$)/); next }
    in_font && /^[[:space:]]*base-size[[:space:]]*=/ {
      v = $0
      sub(/^[^=]*=[[:space:]]*/, "", v)
      sub(/[[:space:]]*(#.*)?$/, "", v)
      print v
      exit
    }
  ' "$shell_config"
}

# Upsert base-size under [font]: replace in place if present, insert into an
# existing [font] section, or append a fresh [font] section. Other sections
# and keys in the user override are left untouched.
set_base_size() {
  local size="$1"
  mkdir -p "$(dirname "$shell_config")"

  if [[ ! -f $shell_config ]]; then
    printf '[font]\nbase-size = %s\n' "$size" >"$shell_config"
    return
  fi

  local tmp
  tmp="$(mktemp)"
  awk -v val="$size" '
    function emit_base() { print "base-size = " val; done = 1 }
    /^[[:space:]]*\[/ {
      if (in_font && !done) emit_base()
      in_font = ($0 ~ /^[[:space:]]*\[font\]([[:space:]]|$)/)
      print
      next
    }
    in_font && /^[[:space:]]*base-size[[:space:]]*=/ {
      if (!done) emit_base()
      next
    }
    { print }
    END {
      if (in_font && !done) emit_base()
      if (!done) {
        if (NR > 0) print ""
        print "[font]"
        emit_base()
      }
    }
  ' "$shell_config" >"$tmp"
  mv "$tmp" "$shell_config"
}

reset_base_size() {
  [[ -f $shell_config ]] || return 0
  local tmp
  tmp="$(mktemp)"
  awk '
    /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\]([[:space:]]|$)/) }
    in_font && /^[[:space:]]*base-size[[:space:]]*=/ { next }
    { print }
  ' "$shell_config" >"$tmp"
  mv "$tmp" "$shell_config"
}

# ---- GTK text-scaling-factor ----

# Point size of the GTK interface font (font-name). Falls back to the GNOME
# default of 11 when unreadable — same as omarchy-display-text-size.
gtk_font_pt() {
  local name pt
  name="$(gsettings get "$GKEY_SCHEMA" font-name 2>/dev/null)"
  pt="${name%\'}"
  pt="${pt##* }"
  if [[ $pt =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "$pt"
  else
    echo 11
  fi
}

current_factor() {
  local f
  f="$(gsettings get "$GKEY_SCHEMA" "$GKEY_NAME" 2>/dev/null)"
  f="${f:-$GTK_DEFAULT_FACTOR}"
  awk -v f="$f" 'BEGIN { printf "%.4f", f + 0 }'
}

# Effective interface-font point size the factor currently renders at.
gtk_current_pt() {
  awk -v f="$(current_factor)" -v p="$(gtk_font_pt)" \
    'BEGIN { printf "%d", int(f * p + 0.5) }'
}

# Factor for a whole point size, so the interface font never lands on a
# fractional point.
gtk_factor_for() {
  awk -v k="$1" -v p="$(gtk_font_pt)" 'BEGIN { printf "%.4f", k / p }'
}

set_factor() {
  gsettings set "$GKEY_SCHEMA" "$GKEY_NAME" "$1" 2>/dev/null || true
}

# ---- terminal font point size ----

term_current_pt() {
  if [[ -f ~/.config/ghostty/config ]]; then
    grep -oP '^font-size = \K[0-9.]+' ~/.config/ghostty/config | head -1
  elif [[ -f ~/.config/alacritty/alacritty.toml ]]; then
    grep -oP '^size[[:space:]]*=[[:space:]]*\K[0-9.]+' ~/.config/alacritty/alacritty.toml | head -1
  elif [[ -f ~/.config/kitty/kitty.conf ]]; then
    local pt
    pt=$(grep -oP '^[[:space:]]*font_size[[:space:]]+\K[0-9.]+' ~/.config/kitty/kitty.conf | tail -1)
    echo "${pt:-$TERM_DEFAULT_PT}"
  elif [[ -f ~/.config/foot/foot.ini ]]; then
    grep -oP ':size=\K[0-9.]+' ~/.config/foot/foot.ini | head -1
  elif omarchy-cmd-present kitty; then
    echo "$TERM_DEFAULT_PT"
  fi
}

# Set the font point size in terminal configs, creating Kitty overrides when
# it inherits its size from the system config. Family is left untouched —
# that is omarchy-font-set's job. Live-reload signals mirror
# omarchy-display-text-size; foot has no reload signal, so running instances
# are nudged.
set_terminal_size() {
  local pt="$1"

  if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
    sed -i -E "s/^size[[:space:]]*=.*/size = $pt/" ~/.config/alacritty/alacritty.toml
  fi

  if [[ -f ~/.config/kitty/kitty.conf ]] || omarchy-cmd-present kitty; then
    mkdir -p ~/.config/kitty
    if grep -qE '^[[:space:]]*font_size[[:space:]]+' ~/.config/kitty/kitty.conf 2>/dev/null; then
      sed --follow-symlinks -i -E "s/^[[:space:]]*font_size[[:space:]]+.*/font_size $pt.0/" ~/.config/kitty/kitty.conf
    else
      printf '\nfont_size %s.0\n' "$pt" >>~/.config/kitty/kitty.conf
    fi
    pkill -USR1 kitty 2>/dev/null || true
  fi

  if [[ -f ~/.config/ghostty/config ]]; then
    sed -i -E "s/^font-size = .*/font-size = $pt/" ~/.config/ghostty/config
    pkill -SIGUSR2 ghostty 2>/dev/null || true
  fi

  if [[ -f ~/.config/foot/foot.ini ]]; then
    sed -i -E "s/(:size=)[0-9.]+/\1$pt/" ~/.config/foot/foot.ini
    # Foot has no config-reload signal, so a running instance keeps its
    # startup size until relaunched. Reuse one notification id (freedesktop
    # replaces_id) so dragging through several sizes refreshes one toast.
    if pgrep -x foot >/dev/null 2>&1; then
      local id_file="${XDG_RUNTIME_DIR:-/tmp}/font-size-ctl.foot-notif-id"
      local prev_id=""
      [[ -f $id_file ]] && read -r prev_id <"$id_file" 2>/dev/null
      local replace=()
      [[ $prev_id =~ ^[0-9]+$ ]] && replace=(-r "$prev_id")
      local new_id
      new_id="$(omarchy-notification-send \
        "Restart Foot to apply the new terminal font size" \
        "${replace[@]}" -p 2>/dev/null)" || true
      [[ $new_id =~ ^[0-9]+$ ]] && printf '%s\n' "$new_id" >"$id_file"
    fi
  fi
}

# ---- get ----

print_status() {
  local shell_px gtk_fpt gtk_factor gtk_pt term_pt
  shell_px="$(current_base_size)"
  gtk_fpt="$(gtk_font_pt)"
  gtk_factor="$(current_factor)"
  gtk_pt="$(gtk_current_pt)"
  term_pt="$(term_current_pt)"
  term_pt="$(awk -v t="${term_pt:-$TERM_DEFAULT_PT}" 'BEGIN { printf "%d", int(t + 0.5) }')"
  printf 'shell-px=%s\n' "${shell_px:-$SHELL_DEFAULT_PX}"
  printf 'gtk-font-pt=%s\n' "$gtk_fpt"
  printf 'gtk-factor=%s\n' "$gtk_factor"
  printf 'gtk-pt=%s\n' "$gtk_pt"
  printf 'term-pt=%s\n' "$term_pt"
}

# ---- set ----

require_range() {
  local label="$1" value="$2" min="$3" max="$4"
  is_int "$value" || die "$label must be an integer between $min and $max."
  # 10# keeps values like 08 from being read as octal.
  ((10#$value >= 10#$min && 10#$value <= 10#$max)) || die "$label must be an integer between $min and $max."
}

# ---- dispatch ----

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  get)
    print_status
    exit 0
    ;;
  reset)
    case "${2:-all}" in
      shell) reset_base_size ;;
      gtk) gsettings reset "$GKEY_SCHEMA" "$GKEY_NAME" 2>/dev/null || true ;;
      term) set_terminal_size "$TERM_DEFAULT_PT" ;;
      all)
        reset_base_size
        gsettings reset "$GKEY_SCHEMA" "$GKEY_NAME" 2>/dev/null || true
        set_terminal_size "$TERM_DEFAULT_PT"
        ;;
      *) die "reset target must be shell, gtk, term, or all." ;;
    esac
    exit 0
    ;;
  set)
    shift
    [[ $# -gt 0 ]] || die "set needs at least one of --shell, --gtk, --term."
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --shell)
          require_range "shell size" "${2:-}" "$MIN_SHELL_PX" "$MAX_SHELL_PX"
          # 10# strips leading zeros so the TOML value is a plain integer.
          set_base_size "$((10#$2))"
          shift 2
          ;;
        --gtk)
          require_range "GTK size" "${2:-}" "$MIN_GTK_PT" "$MAX_GTK_PT"
          set_factor "$(gtk_factor_for "$((10#$2))")"
          shift 2
          ;;
        --term)
          require_range "terminal size" "${2:-}" "$MIN_TERM_PT" "$MAX_TERM_PT"
          set_terminal_size "$((10#$2))"
          shift 2
          ;;
        *) die "unknown argument: $1" ;;
      esac
    done
    exit 0
    ;;
  *)
    die "unknown command: ${1:-}"
    ;;
esac
